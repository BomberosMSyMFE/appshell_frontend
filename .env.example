# =============================================================================
# EJEMPLO DE VARIABLES DE ENTORNO: appshell_frontend (Host Anfitrión)
# Copia este archivo a .env y modifica las URLs según tu entorno de despliegue
# =============================================================================

# Cambiar a false cuando los microservicios backend estén levantados en tu máquina o nube
USE_MOCKS=true

# Endpoints de Microservicios Backend
API_MS1_URL=http://localhost:3000/api/v1

# URLs donde se sirven los remoteEntry.js de los microfrontends
MFE1_CRISIS_URL=http://localhost:4201/remoteEntry.js
MFE2_FLOTAS_URL=http://localhost:4202/remoteEntry.js
MFE3_INVENTARIO_URL=http://localhost:4203/remoteEntry.js
